{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/research-request.schema.json",
  "title": "Research Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "objective", "questions"],
  "properties": {
    "topic_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audience": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "date_from": {
          "type": "string",
          "format": "date"
        },
        "date_to": {
          "type": "string",
          "format": "date"
        },
        "include": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "source_preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_domains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "excluded_domains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "minimum_evidence_tier": {
          "type": "string",
          "enum": ["A", "B", "C", "D"]
        }
      }
    },
    "knowledge_base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_first": {
          "type": "boolean",
          "default": true
        },
        "allow_web_refresh": {
          "type": "boolean",
          "default": true
        },
        "refresh_expired_sources": {
          "type": "boolean",
          "default": true
        },
        "force_web_refresh": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "default": "zh-TW"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
          },
          "default": ["zh-TW"]
        },
        "primary_language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
          "default": "zh-TW"
        },
        "format": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["markdown", "json"]
          },
          "default": ["markdown", "json"]
        }
      }
    }
  }
}
