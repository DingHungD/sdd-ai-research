{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/source-record.schema.json",
  "title": "Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "title",
    "url",
    "canonical_url",
    "content_hash",
    "locator",
    "retrieved_at",
    "local_snapshots",
    "freshness",
    "source_type",
    "evidence_tier",
    "quality",
    "evidence_chain",
    "supported_claim_ids"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^S-[0-9]{3,}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "canonical_url": { "type": "string", "format": "uri" },
    "immutable_url": { "type": "string", "format": "uri" },
    "version": { "type": "string" },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "locator": { "type": "string", "minLength": 1 },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "author_or_organization": { "type": "string" },
    "publisher": { "type": "string" },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "local_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["snapshot_id", "captured_at", "local_path", "content_hash", "mime_type"],
        "properties": {
          "snapshot_id": {
            "type": "string",
            "pattern": "^SNAP-[0-9]{8}T[0-9]{6}Z$"
          },
          "captured_at": { "type": "string", "format": "date-time" },
          "local_path": { "type": "string", "minLength": 1 },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          },
          "mime_type": { "type": "string" }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["stable", "periodic", "volatile"]
        },
        "recheck_after": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "reason": { "type": "string" }
      }
    },
    "source_type": {
      "type": "string",
      "enum": [
        "official",
        "official_documentation",
        "repository_file",
        "release_note",
        "issue_or_discussion",
        "pull_request",
        "law_or_regulation",
        "dataset",
        "research_paper",
        "institutional_report",
        "news",
        "professional_article",
        "community",
        "other"
      ]
    },
    "evidence_tier": {
      "type": "string",
      "enum": ["A", "B", "C", "D"]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "directness",
        "recency",
        "transparency",
        "independence",
        "reproducibility"
      ],
      "properties": {
        "authority": { "type": "string", "enum": ["high", "medium", "low"] },
        "directness": { "type": "string", "enum": ["high", "medium", "low"] },
        "recency": { "type": "string", "enum": ["high", "medium", "low"] },
        "transparency": { "type": "string", "enum": ["high", "medium", "low"] },
        "independence": { "type": "string", "enum": ["high", "medium", "low"] },
        "reproducibility": { "type": "string", "enum": ["high", "medium", "low"] },
        "notes": { "type": "string" }
      }
    },
    "conflict_of_interest": { "type": "string" },
    "evidence_chain": { "type": "string", "minLength": 1 },
    "supported_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^C-[0-9]{3,}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "freshness": {
            "properties": {
              "mode": { "enum": ["periodic", "volatile"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "freshness": {
            "required": ["recheck_after"]
          }
        }
      }
    }
  ]
}
