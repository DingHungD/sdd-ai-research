{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/report.schema.json",
  "title": "Trusted Research Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "version",
    "title",
    "generated_at",
    "data_cutoff",
    "overall_confidence",
    "quality_score",
    "structural_score",
    "quality_metrics",
    "executive_summary",
    "questions",
    "scope",
    "methodology",
    "claims",
    "sources",
    "conflicts",
    "unknowns",
    "resolution_matrix",
    "limitations",
    "conclusion",
    "recommendation_sections",
    "changelog"
  ],
  "properties": {
    "report_id": { "type": "string", "minLength": 1 },
    "report_set_id": { "type": "string", "minLength": 1 },
    "primary_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
      },
      "uniqueItems": true
    },
    "localized_content": { "$ref": "#/$defs/localizedContent" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "data_cutoff": { "type": "string", "format": "date-time" },
    "overall_confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "structural_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "quality_metrics": { "$ref": "#/$defs/qualityMetrics" },
    "minimum_sources": { "type": "integer", "minimum": 0 },
    "minimum_primary_sources": { "type": "integer", "minimum": 0 },
    "minimum_high_quality_sources": { "type": "integer", "minimum": 0 },
    "executive_summary": { "type": "string", "minLength": 1 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "scope": { "$ref": "#/$defs/scope" },
    "methodology": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "source-record.schema.json" }
    },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "resolution_matrix": { "$ref": "#/$defs/resolutionMatrix" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "conclusion": { "type": "string", "minLength": 1 },
    "recommendation_sections": { "$ref": "#/$defs/recommendationSections" },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "localizedContent": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/localizedReportContent" },
      "minProperties": 1
    },
    "localizedReportContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "executive_summary": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/$defs/stringArray" }
          ]
        },
        "methodology": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/$defs/stringArray" }
          ]
        },
        "claim_text": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "claim_reasoning": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "recommendations": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/$defs/stringArray" }
          ]
        },
        "conclusion": { "type": "string", "minLength": 1 },
        "limitations": { "$ref": "#/$defs/stringArray" }
      }
    },
    "sourceIdArray": {
      "type": "array",
      "items": { "type": "string", "pattern": "^S-[0-9]{3,}$" }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "audience": { "type": "string" },
        "regions": { "$ref": "#/$defs/stringArray" },
        "languages": { "$ref": "#/$defs/stringArray" },
        "date_range": { "type": "string" },
        "include": { "$ref": "#/$defs/stringArray" },
        "exclude": { "$ref": "#/$defs/stringArray" }
      }
    },
    "qualityMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality_score",
        "structural_score",
        "critical_claim_coverage",
        "source_quality",
        "traceability",
        "limitations_and_resolutions",
        "freshness_and_reproducibility",
        "notes"
      ],
      "properties": {
        "quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "structural_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "critical_claim_coverage": { "type": "string" },
        "source_quality": { "type": "string" },
        "traceability": { "type": "string" },
        "limitations_and_resolutions": { "type": "string" },
        "freshness_and_reproducibility": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text",
        "type",
        "importance",
        "confidence",
        "confidence_reason",
        "supporting_source_ids",
        "opposing_source_ids",
        "notes"
      ],
      "properties": {
        "claim_id": { "type": "string", "pattern": "^C-[0-9]{3,}$" },
        "text": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["fact", "inference", "recommendation", "unknown"] },
        "importance": { "type": "string", "enum": ["critical", "supporting", "context"] },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "confidence_reason": { "type": "string", "minLength": 1 },
        "supporting_source_ids": { "$ref": "#/$defs/sourceIdArray" },
        "opposing_source_ids": { "$ref": "#/$defs/sourceIdArray" },
        "notes": { "type": "string" }
      }
    },
    "resolutionMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "conflict_resolutions", "unknown_resolutions"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "conflict_resolutions": {
          "type": "array",
          "items": { "$ref": "#/$defs/resolutionItem" }
        },
        "unknown_resolutions": {
          "type": "array",
          "items": { "$ref": "#/$defs/resolutionItem" }
        }
      }
    },
    "resolutionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution_id",
        "title",
        "status",
        "decision",
        "resolution_method",
        "supporting_source_ids",
        "next_action",
        "closure_criteria"
      ],
      "properties": {
        "resolution_id": { "type": "string", "pattern": "^R[CU]-[0-9]{3,}$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["resolved", "partially_resolved", "open"] },
        "decision": { "type": "string", "minLength": 1 },
        "resolution_method": { "type": "string", "minLength": 1 },
        "supporting_source_ids": { "$ref": "#/$defs/sourceIdArray" },
        "next_action": { "type": "string", "minLength": 1 },
        "closure_criteria": { "type": "string", "minLength": 1 }
      }
    },
    "recommendationSections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementability", "open_source_options", "future_directions"],
      "properties": {
        "implementability": { "$ref": "#/$defs/implementabilitySection" },
        "open_source_options": { "$ref": "#/$defs/openSourceOptions" },
        "future_directions": { "$ref": "#/$defs/futureDirectionsSection" }
      }
    },
    "implementabilitySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "items"],
      "properties": {
        "summary": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/implementabilityItem" } }
      }
    },
    "implementabilityItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "objective", "technologies", "workflow", "minimum_deliverable", "acceptance_criteria", "supporting_source_ids", "research_prompt"],
      "properties": {
        "title": { "type": "string" },
        "objective": { "type": "string" },
        "technologies": { "$ref": "#/$defs/stringArray" },
        "workflow": { "type": "string" },
        "minimum_deliverable": { "type": "string" },
        "acceptance_criteria": { "type": "string" },
        "supporting_source_ids": { "$ref": "#/$defs/sourceIdArray" },
        "research_prompt": { "type": "string" }
      }
    },
    "openSourceOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "single_tool_recommendations", "multi_tool_recommendations"],
      "properties": {
        "summary": { "type": "string" },
        "single_tool_recommendations": { "$ref": "#/$defs/singleToolSection" },
        "multi_tool_recommendations": { "$ref": "#/$defs/multiToolSection" }
      }
    },
    "singleToolSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "items"],
      "properties": {
        "summary": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/singleToolItem" } }
      }
    },
    "singleToolItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "tool", "recommendation_reason", "suitable_for", "strengths", "gaps", "minimum_adoption", "supporting_source_ids", "research_prompt"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "tool": { "type": "string" },
        "recommendation_reason": { "type": "string" },
        "suitable_for": { "type": "string" },
        "strengths": { "$ref": "#/$defs/stringArray" },
        "gaps": { "type": "string" },
        "minimum_adoption": { "type": "string" },
        "supporting_source_ids": { "$ref": "#/$defs/sourceIdArray" },
        "research_prompt": { "type": "string" }
      }
    },
    "multiToolSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "items"],
      "properties": {
        "summary": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/multiToolItem" } }
      }
    },
    "multiToolItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "title", "tools", "objective", "roles", "workflow", "recommendation_reason", "tradeoffs", "minimum_deliverable", "acceptance_criteria", "supporting_source_ids", "research_prompt"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "tools": { "$ref": "#/$defs/stringArray" },
        "objective": { "type": "string" },
        "roles": { "type": "string" },
        "workflow": { "type": "string" },
        "recommendation_reason": { "type": "string" },
        "tradeoffs": { "type": "string" },
        "minimum_deliverable": { "type": "string" },
        "acceptance_criteria": { "type": "string" },
        "supporting_source_ids": { "$ref": "#/$defs/sourceIdArray" },
        "research_prompt": { "type": "string" }
      }
    },
    "futureDirectionsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "items"],
      "properties": {
        "summary": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/futureDirectionItem" } }
      }
    },
    "futureDirectionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "current_limitation", "direction", "trigger", "supporting_source_ids", "research_prompt"],
      "properties": {
        "title": { "type": "string" },
        "current_limitation": { "type": "string" },
        "direction": { "type": "string" },
        "trigger": { "type": "string" },
        "supporting_source_ids": { "$ref": "#/$defs/sourceIdArray" },
        "research_prompt": { "type": "string" }
      }
    }
  }
}
