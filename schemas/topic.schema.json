{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/topic.schema.json",
  "title": "Local Knowledge Base Topic",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic_id", "title", "description", "questions", "keywords"],
  "properties": {
    "topic_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "text"],
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^RQ-[0-9]{3,}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "categories": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "default_recheck_days": {
      "type": "integer",
      "minimum": 1
    }
  }
}
