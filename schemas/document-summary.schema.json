{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/document-summary.schema.json",
  "title": "Document Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "snapshot_id",
    "summarized_at",
    "document_purpose",
    "summary",
    "key_points",
    "keywords",
    "limitations"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^S-[0-9]{3,}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^SNAP-[0-9]{8}T[0-9]{6}Z$"
    },
    "summarized_at": {
      "type": "string",
      "format": "date-time"
    },
    "document_purpose": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "role_in_ecosystem": { "type": "string" },
    "architecture_fit": { "type": "string" },
    "workflow_outline": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "key_features": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "key_technologies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "best_for": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "research_value": { "type": "string" },
    "verification_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "categories": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "locator"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "entities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "potential_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "repo_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "repository_kind",
        "files_reviewed",
        "files_not_reviewed",
        "feature_inventory",
        "architecture_summary",
        "core_files",
        "capability_boundaries",
        "operational_model",
        "quality_signals",
        "evidence_coverage",
        "open_questions"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "repository_kind": { "type": "string", "minLength": 1 },
        "files_reviewed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "permalink", "why_selected", "evidence_used"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "permalink": { "type": "string", "minLength": 1 },
              "why_selected": { "type": "string", "minLength": 1 },
              "evidence_used": { "type": "string", "minLength": 1 }
            }
          }
        },
        "files_not_reviewed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern_or_path", "reason"],
            "properties": {
              "pattern_or_path": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "feature_inventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["feature", "evidence_locators", "confidence"],
            "properties": {
              "feature": { "type": "string", "minLength": 1 },
              "evidence_locators": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
            }
          }
        },
        "architecture_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["components", "data_or_control_flow", "extension_points"],
          "properties": {
            "components": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "data_or_control_flow": { "type": "string", "minLength": 1 },
            "extension_points": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "core_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role", "locators"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "locators": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "capability_boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "not_supported", "unclear"],
          "properties": {
            "supported": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "not_supported": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "unclear": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "operational_model": { "type": "string", "minLength": 1 },
        "quality_signals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readme", "docs", "source", "tests", "examples", "release_notes"],
          "properties": {
            "readme": { "type": "boolean" },
            "docs": { "type": "boolean" },
            "source": { "type": "boolean" },
            "tests": { "type": "boolean" },
            "examples": { "type": "boolean" },
            "release_notes": { "type": "boolean" }
          }
        },
        "open_questions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
